# Make.com Webhook
VITE_WEBHOOK_URL=https://hook.eu2.make.com/your-webhook-id

# Website-Testanruf: nur in Cloudflare Pages als Secret setzen, niemals mit VITE_-Präfix.
# Zusätzlich braucht das Pages-Projekt eine KV-Bindung namens TEST_CALL_LIMITS.
CONVOCORE_API_KEY=your-convocore-secret
CONVOCORE_AGENT_ID=your-agent-id
CONVOCORE_FROM=+49000000000
# Optional, Standard: 30 Anrufe pro Tag
TEST_CALL_DAILY_LIMIT=30
